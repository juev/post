<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Failures, sign-in requests, progress and the optional success summary (product.md R32). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A run that uploads video or large files, or converts video, goes to the foreground (scheduling.md M2, M5). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- One exact alarm at the earliest send time, which fires in Doze (scheduling.md M1). Granted at install;
         the Google Play policy on it does not apply to an app installed through Obtainium. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Alarms are lost on reboot and set again on BOOT_COMPLETED (M3). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility (API 30+): find the browser that offers Custom Tabs and Auth Tab. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".PostApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Post">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The Mastodon OAuth redirect after a Custom Tab (networks.md N4). Exported for the browser; a
             redirect whose state Post did not issue is rejected without any request. -->
        <activity
            android:name=".oauth.OAuthRedirectActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:path="/mastodon"
                    android:scheme="org.evsyukov.post" />
            </intent-filter>
        </activity>
        <!-- The Cancel action of the video conversion notification (media.md A7). -->
        <receiver
            android:name=".send.CancelSendReceiver"
            android:exported="false" />
        <!-- The exact alarm of the sender (scheduling.md M1, M2). -->
        <receiver
            android:name=".send.schedule.PublishAlarmReceiver"
            android:exported="false" />
        <!-- Boot, time, time zone and app update set the alarm again and look for late posts (M3). The system
             sends these broadcasts, and it reaches receivers that are not exported. -->
        <receiver
            android:name=".send.schedule.ScheduleRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Send now and Reschedule of the late notification (Q6). -->
        <receiver
            android:name=".send.schedule.LateActionReceiver"
            android:exported="false" />
        <!-- WorkManager's foreground service: dataSync for uploads, mediaProcessing for video conversion on 35+. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|mediaProcessing"
            tools:node="merge" />
    </application>

</manifest>
