<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share (product.md R23): the sharing shortcut of DirectShare carries this category, so the share sheet
     offers it for the types the Share activity takes (R19). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="org.evsyukov.post.share.ShareActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <category android:name="org.evsyukov.post.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
