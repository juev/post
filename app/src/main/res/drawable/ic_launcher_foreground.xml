<?xml version="1.0" encoding="utf-8"?>
<!--
  A paper plane flying up and to the right, leaving two diverging dashed trails: one post going to
  several networks. The layer uses the 108dp adaptive icon grid, one viewport unit per dp. Every shape
  lies inside the central 66dp safe zone, the circle of radius 33 around (54,54): the nose is 31.1 away
  from the centre, the trails with their round caps at most 29.8. The shapes are white on transparent,
  so the same layer serves as the monochrome one. docs/icon/icon.svg repeats these paths.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The upper wing. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M76,32L36,47L55,53.5Z" />
    <!-- The lower wing, apart from the upper one along the fold. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M76,32L57.5,56L62.5,71Z" />
    <!-- The trail to the left. -->
    <path
        android:pathData="M47,58.5C44.25,59.65 41.12,60.67 37.81,61.49M33.35,62.43C31.42,62.77 29.46,63.03 27.5,63.2"
        android:strokeWidth="3.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <!-- The trail downwards. -->
    <path
        android:pathData="M52.5,64C51.6,66.75 50.62,69.62 49.61,72.5M48.26,76.28C47.68,77.88 47.09,79.46 46.5,81"
        android:strokeWidth="3.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
</vector>
